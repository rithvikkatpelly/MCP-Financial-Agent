# Copy this file to .env and fill in your own keys.

# --- FRED (the MCP server + live data) ----------------------------------
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Serve every FRED call from the built-in synthetic fixture instead of the
# network. The evaluation harness and the test suite set this themselves.
FRED_OFFLINE=0

# --- Multi-agent orchestrator (src/agents) -----------------------------
# "stub"      -> deterministic offline planner (default; no key, no cost)
# "anthropic" -> real Claude tool-use loop (needs ANTHROPIC_API_KEY)
AGENT_BACKEND=stub
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5

# --- Guardrails --------------------------------------------------------
# Rough per-session token budget guardrail (see src/cost_tracker.py)
SESSION_TOKEN_BUDGET=50000

# MCP-boundary rate limit (see src/rate_limit.py)
TOOL_RATE_LIMIT_PER_MIN=120
TOOL_RATE_LIMIT_BURST=30
